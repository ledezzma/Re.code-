#ReCode/.env.example
#Backend ReCode/api/app,py

DB_HOST = 127.0.0.1
DB_PORT = 3306
DB_USER = root
DB_PASSWORD =
DB_NAME = servidor

#Frontend ReCode/app/.env
EXPO_PUBLIC_API_URL = http://IP_LOCAL:8000 #varia dependiendo la red local, se puede obtener con ifconfig o ipconfig, o con el comando "ip addr" en linux. Cambiar IP_LOCAL por la ip de la computadora que corre el backend.